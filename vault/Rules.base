filters: 'file.folder == "Rules"'
properties:
  file.name:
    displayName: "Rule Title"
  category:
    displayName: "Rule Category"
  tags:
    displayName: "Tags"
views:
  - type: cards
    name: "Rules Gallery"
    order:
      - file.name
      - category
      - tags
  - type: table
    name: "Rules Table"
    order:
      - file.name
      - category
      - tags

filters: 'file.folder == "Pages"'
properties:
  file.name:
    displayName: "Note Name"
  pdfPage:
    displayName: "PDF Page"
  printedPage:
    displayName: "Printed Page"
  chapter:
    displayName: "Chapter"
  topics:
    displayName: "Topics"
views:
  - type: table
    name: "Pages Table"
    order:
      - pdfPage
      - file.name
      - printedPage
      - chapter
      - topics

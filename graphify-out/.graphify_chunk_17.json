    },
    {
      "id": "concept_statement_of_claim",
      "label": "Statement of Claim",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-64.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fundamental document in civil proceedings that sets out who is claiming what, from whom, and why. Used generically to cover various forms including particulars of claim, declarations, counterclaims, third-party claims, and interpleader claims."
    },
    {
      "id": "concept_cause_of_action",
      "label": "Cause of Action",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-65.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A set of facts giving rise to a claim recognised by law. Must traverse all material facts and can be classified as contractual, delictual, enrichment, statutory, or mixed claims."
    },
    {
      "id": "concept_locus_standii",
      "label": "Locus Standi",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-64.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Capacity to participate in legal proceedings. Primary sense refers to capacity to sue/be sued; secondary sense refers to legal relationship between plaintiff and subject-matter of claim."
    },
    {
      "id": "concept_prayer",
      "label": "Prayer",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-65.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Determines parties, jurisdiction, cause of action pleading, and relief wording. A statement of claim without a prayer is deficient and may be set aside."
    },
    {
      "id": "concept_particulars_claim",
      "label": "Particulars of Claim",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-66.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Document attached to combined summons for unliquidated claims. Must identify material facts (facta probanda) including plaintiff's interest, defendant's negligent act, causation, damage, and loss."
    },
    {
      "id": "concept_declaration",
      "label": "Declaration",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-69.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Full details of claim delivered when liquidated claim is defended. Must state whether contract is oral or written under Rule 18(6)."
    },
    {
      "id": "concept_counterclaim",
      "label": "Counterclaim",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-71.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Claim by defendant against plaintiff in existing proceedings. Resolves all outstanding claims between parties for final accounting."
    },
    {
      "id": "concept_third_party_claim",
      "label": "Third-Party Claim",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-72.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Used to join additional parties under Rule 13. Available for contribution claims, indemnity claims, or common issues. Creates separate lis between issuing party and third party."
    },
    {
      "id": "concept_interpleader_claim",
      "label": "Interpleader Claim",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-75.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Under Rule 58, for competing claims to same thing/money. Applicant claims no interest, does not collude, and offers to deal with property as court directs."
    },
    {
      "id": "concept_liquid_document",
      "label": "Liquid Document",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-77.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Document where defendant admits/acknowledges indebtedness for fixed amount. Must be written, signed, unconditional. Basis for provisional sentence summons under Rule 8."
    },
    {
      "id": "concept_charge_criminal",
      "label": "Criminal Charge",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-78.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Under Criminal Procedure Act 51 of 1977 (s 84), must set forth offence with particulars of time, place, person/property, and reasonably sufficient notice of charge nature."
    },
    {
      "id": "concept_plea",
      "label": "Plea",
      "file_type": "concept",
      "source_file": "/Users/ajadvanwyk/Downloads/Litigation Skills for South African Lawyers.pdf/vault/Pages/Page-79.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Defendant's answer to plaintiff's statement of claim. States grounds of defence and material facts relied upon. Must distinguish between denial raising factual issue and defence introducing new matter "
    }
  ],

filters: 'file.name.contains("Page-") && (chapter != "")'
properties:
  chapter:
    displayName: "Chapter Name"
  pdfPage:
    displayName: "Starting Page"
views:
  - type: list
    name: "Chapters View"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - chapter
      - pdfPage

filters: file.folder == "Litigation Skills"
properties:
  file.name:
    displayName: Chapter Title
  pageRange:
    displayName: PDF Page Range
  topics:
    displayName: Topics Covered
views:
  - type: table
    name: Chapters Overview Table
    order:
      - file.name
      - pageRange
      - topics
  - type: list
    name: Chapters List
    order:
      - file.name
